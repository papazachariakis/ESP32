  const char* ssid;
  const char* pass;
};

static const WifiSeed WIFI_SEEDS[] = {
  {WIFI_DEFAULT_SSID_PRIMARY, "YOUR_MIKROTIK_PASSWORD"},
  {WIFI_DEFAULT_SSID_SECONDARY, "YOUR_KALITHEA_PASSWORD"},
};

